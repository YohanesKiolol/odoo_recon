# Odoo URLs
ODOO_URL=
ODOO_DASHBOARD_URL=
ODOO_PAYMENTS_URL=
ODOO_JOURNAL_IMPORT_URL=

# Journal Automation Config
ODOO_COMPANY_NAME="Eyerizz Eyewear"
ODOO_JOURNAL_EDC="EDC Settlement Journal"
ODOO_JOURNAL_AR="MDR Fees Journal"
JOURNAL_TEMPLATE_DIR=
JOURNAL_EXCEL_PATTERN="Journal Entry (account.move).xlsx"
# Path to the Odoo exported Excel file (always named "Payments (account.payment).xlsx")
ODO_EXCEL_PATH=

# Column name for amount in Odoo file
ODO_AMOUNT_COLUMN=

# Column name for reference number in Odoo file (shown when status = Cuma ada di ODO)
ODO_NUMBER_COLUMN=

# Exact group/type names in the Odoo file (used to filter rows per bank)
ODO_GROUP_BCA=
ODO_GROUP_MANDIRI=
ODO_GROUP_BRI=


# ─── Mandiri ─────────────────────────────────────────────────────────────────
# Folder where the Mandiri ZIP files are placed
ACCOUNT_BCA_main_MID=
ACCOUNT_BCA_main_GROUP=
ACCOUNT_BCA_main_ACC="8311411868"
ACCOUNT_BCA_main_EDC_DEBIT="11018 BCA EDC Settlement"
ACCOUNT_BCA_main_EDC_CREDIT="100040 BCA Main EDC in transit"

# Mandiri
ACCOUNT_MANDIRI_main_MID=
ACCOUNT_MANDIRI_main_GROUP=
ACCOUNT_MANDIRI_main_ACC="1180067878883"
ACCOUNT_MANDIRI_main_EDC_DEBIT=
ACCOUNT_MANDIRI_main_EDC_CREDIT=

# BRI
ACCOUNT_BRI_lbf_MID=
ACCOUNT_BRI_lbf_GROUP=
ACCOUNT_BRI_lbf_ACC=
ACCOUNT_BRI_lbf_EDC_DEBIT=
ACCOUNT_BRI_lbf_EDC_CREDIT=

ACCOUNT_BRI_frans_MID=
ACCOUNT_BRI_frans_GROUP=
ACCOUNT_BRI_frans_ACC=
ACCOUNT_BRI_frans_EDC_DEBIT=
ACCOUNT_BRI_frans_EDC_CREDIT=

ACCOUNT_BRI_nara_MID=
ACCOUNT_BRI_nara_GROUP=
ACCOUNT_BRI_nara_ACC="001701005774562"
ACCOUNT_BRI_nara_EDC_DEBIT=
ACCOUNT_BRI_nara_EDC_CREDIT=

# Folder where the Mandiri ZIP files are placed
MANDIRI_ZIP_DIR=

# Glob pattern to identify Mandiri ZIP files inside MANDIRI_ZIP_DIR
MANDIRI_ZIP_PATTERN=

# Pattern to find Mandiri Mutation CSV files
MANDIRI_MUTATION_PATTERN="account_statement"

# Password for Mandiri ZIP files
MANDIRI_ZIP_PASSWORD=

# Column name for amount in Mandiri CSV (header is at row 6)
MANDIRI_AMOUNT_COLUMN=

# Column name for reference number in Mandiri CSV (shown when status = Cuma ada di Bank)
# Actual column in MSR CSV: AUTHCODE (authorization code)
MANDIRI_NUMBER_COLUMN=


# ─── BCA ─────────────────────────────────────────────────────────────────────
# Folder where the BCA Excel file is placed
BCA_EXCEL_DIR=

# Pattern to find the BCA Excel file — must contain this substring
# BCA filenames look like: ReportMerchantBCA_20260720.xlsx
BCA_EXCEL_PATTERN=

# Pattern to find BCA Mutation CSV files
BCA_MUTATION_PATTERN="CorpAcctTrxn"

# Password for BCA Excel file
BCA_EXCEL_PASSWORD=

# Column name for amount in BCA Excel (header at row 5)
BCA_AMOUNT_COLUMN= 

# Column name for transaction date in BCA Excel (used to filter by ODO date)
BCA_DATE_COLUMN=

# Column name for reference number in BCA Excel (shown when status = Cuma ada di Bank)
BCA_NUMBER_COLUMN=


# ─── BRI ─────────────────────────────────────────────────────────────────────
# Folder where the BRI ZIP file is placed
BRI_ZIP_DIR=

# Pattern to find the BRI ZIP file — must contain this substring
# BRI ZIP filenames contain '_franswega7' (e.g. 20260720_franswega7_xxxx.zip)
BRI_ZIP_PATTERN=

# Pattern to find BRI Mutation CSV files
BRI_MUTATION_PATTERN="e-StatementBRImo"

# Pattern to find the correct PDF inside the BRI ZIP
# Script picks the PDF whose filename starts with this string
BRI_PDF_PATTERN=

# Column name for amount in BRI PDF table
BRI_AMOUNT_COLUMN=

# Column name for reference number in BRI PDF table (shown when status = Cuma ada di Bank)
BRI_NUMBER_COLUMN=


# ─── Output ──────────────────────────────────────────────────────────────────
OUTPUT_DIR=
JOURNAL_TOLERANCE=200
